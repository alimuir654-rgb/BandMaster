extends "res://native_test.gd"
## Controlled material comparison: only the frame artwork changes.
var evidence_geometry: Array = []
func run() -> void:
    DirAccess.make_dir_recursive_absolute("res://proof")
    root.gui_embed_subwindows = false
    root.position = Vector2i.ZERO
    root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
    root.content_scale_size = Vector2i.ZERO
    for sz in [Vector2i(390,844),Vector2i(720,1280),Vector2i(1280,720),Vector2i(1600,900)]:
        var expected_rect := Rect2()
        for version in ["C20", "C21", "C22"]:
            root.size = sz
            root.show()
            var stage := Control.new()
            stage.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
            root.add_child(stage)
            var background := ColorRect.new()
            background.color = Color("ddd7c8")
            background.mouse_filter = Control.MOUSE_FILTER_IGNORE
            stage.add_child(background)
            background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
            var heading := Kit.label("PAPER FRAME / CONTROLLED COMPARISON", "notepaper", 18)
            heading.position = Vector2(24,24)
            heading.size.x = sz.x - 48
            heading.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
            stage.add_child(heading)
            var note := Kit.label("Identical content, bounds, lighting and state. Native Godot capture.", "notepaper", 14)
            note.position = Vector2(24,80)
            note.size.x = sz.x - 48
            note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
            stage.add_child(note)
            var frame := PanelContainer.new()
            var paths := {"C20":"frame_notepaper_panel.png", "C21":"frame_notepaper_panel_c21.png", "C22":"frame_notepaper_panel_c22.png"}
            var margins := {"C20":40.0, "C21":32.0, "C22":44.0}
            var style := StyleBoxTexture.new()
            style.texture = load("res://art/" + paths[version])
            style.set_texture_margin_all(margins[version])
            style.set_content_margin_all(40)
            frame.add_theme_stylebox_override("panel",style)
            frame.position = Vector2((sz.x-minf(sz.x-48,700))/2.0,145)
            frame.size = Vector2(minf(sz.x-48,700),minf(sz.y-235,450))
            stage.add_child(frame)
            var body := VBoxContainer.new()
            body.add_theme_constant_override("separation",16)
            frame.add_child(body)
            var title := Kit.label("REHEARSAL NOTES", "notepaper", 23)
            title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
            body.add_child(title)
            var copy := Kit.label("Listen together. Refine the arrangement. Keep the next decision clear.","notepaper",17)
            copy.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
            body.add_child(copy)
            var row := HBoxContainer.new()
            row.add_theme_constant_override("separation",8)
            body.add_child(row)
            row.add_child(Kit.label("Tone", "notepaper",16))
            var meter = Kit.PassiveMeter.new("notepaper",8)
            row.add_child(meter)
            row.add_child(Kit.label("8 / 10","notepaper",16))
            var spacer := Control.new()
            spacer.size_flags_vertical = Control.SIZE_EXPAND_FILL
            body.add_child(spacer)
            var button := Kit.button("Review session", "notepaper", "action")
            body.add_child(button)
            await settle()
            var geometry := frame.get_global_rect()
            if version == "C20": expected_rect = geometry
            check(geometry == expected_rect,"Controlled A/B has identical frame bounds")
            check(Rect2(Vector2.ZERO,Vector2(sz)).encloses(geometry),"Frame within native viewport")
            check(geometry.encloses(body.get_global_rect()),"Live content remains inside frame")
            check(button.get_global_rect().size.y >= 44,"Action remains a physical 44px target")
            check(meter.mouse_filter == Control.MOUSE_FILTER_IGNORE and meter.focus_mode == Control.FOCUS_NONE,"Owner-liked meter remains passive")
            var count := [0]
            button.pressed.connect(func(): count[0] += 1)
            await click(root,button)
            check(count[0] == 1,"Real action input still fires once")
            button.release_focus()
            root.warp_mouse(Vector2(sz.x-3,sz.y-3))
            root.notify_mouse_exited()
            await settle()
            var tag := "paper-controlled-%s-%dx%d" % [version,sz.x,sz.y]
            await screenshot(root,tag)
            evidence_geometry.append({"version":version,"viewport":[sz.x,sz.y],"frame_position":[geometry.position.x,geometry.position.y],"frame_size":[geometry.size.x,geometry.size.y]})
            stage.queue_free()
            await process_frame
    var result := FileAccess.open("res://proof/recovery-results.json",FileAccess.WRITE)
    result.store_string(JSON.stringify({"engine":Engine.get_version_info(),"renderer":DisplayServer.get_name(),"assertions":assertions,"failures":failures,"screenshots":records,"controlled_geometry":evidence_geometry},"  "))
    print("C22_RECOVERY_RESULT: ",assertions," checks; ",failures.size()," failures")
    quit(0 if failures.is_empty() and records.size()==12 else 1)
