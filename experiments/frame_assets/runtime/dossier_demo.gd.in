extends Control
const Kit = preload("res://kit.gd")
const Dossier = preload("res://dossier_frame.gd")
var frame
var action: Button
var meter: TextureRect
var heading: Label
var caption: Label
var feedback: Label
var controls: HBoxContainer
var clicks := 0
var selected := "C24"
func _ready() -> void:
    set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    var bg := ColorRect.new()
    bg.color = Color("ddd7c8")
    bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
    add_child(bg)
    bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    var margin := MarginContainer.new()
    margin.set_anchors_and_offsets_preset(Control.PRESET_TOP_WIDE)
    margin.offset_left = 20
    margin.offset_right = -20
    margin.offset_top = 16
    add_child(margin)
    var header := VBoxContainer.new()
    header.add_theme_constant_override("separation", 6)
    margin.add_child(header)
    heading = Kit.label("DOSSIER / MATERIAL PROOF", "notepaper", 18)
    heading.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    header.add_child(heading)
    caption = Kit.label("Same content and size. Only the frame changes.", "notepaper", 14)
    caption.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    header.add_child(caption)
    frame = Dossier.new()
    add_child(frame)
    var title := Kit.label("REHEARSAL NOTES", "notepaper", 22)
    title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    frame.content.add_child(title)
    var sub := Kit.label("WORKING SHEET  /  01", "notepaper", 13)
    frame.content.add_child(sub)
    var copy := Kit.label("Listen together. Refine the arrangement. Keep the next decision clear.", "notepaper", 17)
    copy.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    frame.content.add_child(copy)
    var row := VBoxContainer.new()
    row.add_theme_constant_override("separation", 6)
    frame.content.add_child(row)
    row.add_child(Kit.label("Tone  ·  8 / 10", "notepaper", 15))
    meter = Kit.PassiveMeter.new("notepaper", 8)
    row.add_child(meter)
    var gap := Control.new()
    gap.size_flags_vertical = Control.SIZE_EXPAND_FILL
    frame.content.add_child(gap)
    action = Kit.button("Review notes", "notepaper", "action")
    frame.content.add_child(action)
    action.pressed.connect(func(): clicks += 1; feedback.text = "Reviewed  ·  %d" % clicks)
    controls = HBoxContainer.new()
    controls.add_theme_constant_override("separation", 10)
    add_child(controls)
    for value in ["C20", "C21", "C24"]:
        var b := Kit.button(value, "notepaper", "tab")
        b.custom_minimum_size = Vector2(88, 46)
        controls.add_child(b)
        b.pressed.connect(set_version.bind(value))
    feedback = Kit.label("Live controls; separate source-art layers.", "notepaper", 13)
    feedback.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    feedback.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    add_child(feedback)
    resized.connect(_layout)
    _layout()
func set_version(value: String) -> void:
    selected = value
    frame.set_version(value)
func _layout() -> void:
    if frame == null:
        return
    var available := Vector2(maxf(280, size.x - 40), maxf(420, size.y - 210))
    var height := minf(available.y, 740)
    var width := height * (8.0 / 11.0)
    if width > available.x:
        width = available.x
        height = width / (8.0 / 11.0)
    frame.position = Vector2((size.x - width) / 2, 114)
    frame.size = Vector2(width, height)
    controls.position = Vector2((size.x - 284) / 2, minf(size.y - 77, frame.position.y + height + 12))
    controls.size = Vector2(284, 46)
    feedback.position = Vector2(20, controls.position.y + 49)
    feedback.size = Vector2(size.x - 40, 28)
    for label in [heading, caption, feedback]:
        label.custom_maximum_size = Vector2(size.x - 40, 0)
    for child in frame.content.get_children():
        if child is Label and child.autowrap_mode != TextServer.AUTOWRAP_OFF:
            child.custom_maximum_size = Vector2(width * 0.78, 0)
