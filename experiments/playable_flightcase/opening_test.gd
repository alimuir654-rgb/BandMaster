extends SceneTree
const Opening = preload("res://experiments/playable_flightcase/opening_state.gd")
const Base = preload("res://experiments/character_cast/vendor/recruitment_catalogue_v3.gd")
var failures: Array[String] = []
var checks := 0
func _init() -> void:
 call_deferred("test")
func verify(test_ok: bool, explanation: String) -> void:
 checks += 1
 if not test_ok:
  failures.append(explanation)
  push_error(explanation)
func test() -> void:
 var model = Opening.new()
 verify(model.screen=="menu","opening starts at menu")
 verify(model.begin_new() and model.screen=="genre","New opens genre with saved draft")
 verify(model.has_valid_draft(),"Continue enabled with valid saved draft")
 verify(not model.set_genre("INVALID"),"invalid genre ignored")
 verify(model.set_genre("Post-punk") and model.game.genre=="Post-punk","genre selected")
 verify(model.to_recruit() and model.screen=="recruit","genre leads into recruit")
 verify(not model.confirm_lineup().get("ok",true),"cannot skip roster/lead")
 verify(not model.choose_vocal("cast_jack").get("ok",true),"cannot assign unselected vocalist")
 verify(model.recruit("cast_jack").get("ok",false),"guitar recruited")
 verify(model.recruit("cast_zoe").get("ok",false),"bass recruited")
 verify(model.recruit("cast_casey").get("ok",false),"drums recruited")
 verify(not model.ready() and model.missing().contains("lead vocals"),"three instrumentalists require explicit vocalist")
 var before_voice := model.game.spent()
 verify(model.choose_vocal("cast_jack").get("ok",false),"instrumentalist can be assigned lead")
 verify(model.vocal_extra_cost()==5 and model.remaining()==200-before_voice-5,"doubling singing +5 points disclosed")
 verify(model.ready() and model.missing().is_empty(),"guitar bass drums plus explicit singer ready")
 verify(not model.recruit("cast_jack").get("ok",true),"duplicate blocked in opening")
 var draft := model.snapshot()
 verify(model.save_draft(),"draft save succeeds")
 var resumed = Opening.new()
 verify(resumed.load_draft() and resumed.screen=="recruit","Continue loads recruit stage")
 verify(resumed.snapshot()==draft,"resume preserves roster/genre/vocal/points")
 verify(not resumed.restore({"schema_version":1,"screen":"recruit","game":{"phase":"evil"}}),"corrupt setup rejected")
 verify(resumed.snapshot()==draft,"failed restore does not mutate playable draft")
 verify(resumed.remove_member("cast_jack").get("ok",false),"remove guitarist refunds")
 verify(resumed.lead_vocal_id.is_empty() and not resumed.ready(),"removing singer clears assignment")
 verify(resumed.recruit("cast_jack").get("ok",false),"recruit after refund works")
 verify(resumed.choose_vocal("cast_jack").get("ok",false),"reassign vocals after rehire")
 verify(resumed.confirm_lineup().get("ok",false) and resumed.screen=="formed","milestone1 only after viable lineup")
 verify(resumed.formed_once,"milestone once-only flag")
 verify(not resumed.confirm_lineup().get("ok",true),"second milestone attempt blocked")
 var formed = Opening.new()
 verify(formed.load_draft() and formed.screen=="formed" and formed.formed_once,"milestone1 survives restart")
 verify(formed.remaining()>=0,"formed lineup remains in budget")
 var four = Opening.new()
 four.begin_new()
 four.to_recruit()
 for id in ["cast_jack","cast_zoe","cast_casey","cast_maya"]:
  verify(four.recruit(id).get("ok",false),"four-piece hire "+id)
 verify(four.choose_vocal("cast_maya").get("ok",false),"dedicated singer accepted")
 verify(four.vocal_extra_cost()==0 and four.ready(),"dedicated singer zero double fee")
 verify(four.remaining()==200-four.game.spent(),"four-piece budget exact")
 var invalid = Opening.new()
 verify(not invalid.load_draft() or invalid.has_valid_draft(),"valid source path only")
 print("C27_OPENING_RESULT ",JSON.stringify({"checks":checks,"failures":failures,"partial_stage":"menu_genre_recruit_milestone1","save_path":Opening.SAVE_PATH}))
 quit(0 if failures.is_empty() else 1)
