extends SceneTree
const Opening = preload("res://experiments/playable_flightcase/opening_state.gd")
const Base = preload("res://experiments/character_cast/vendor/recruitment_catalogue_v3.gd")
var failures: Array[String] = []
var checks := 0
func _init() -> void:
 call_deferred("test")
func verify(test_ok: bool, explanation: String) -> void:
 checks += 1
 if not test_ok:
  failures.append(explanation)
  push_error(explanation)
func test() -> void:
 var model = Opening.new()
 verify(model.screen=="menu","opening starts at menu")
 verify(model.begin_new() and model.screen=="genre","New opens genre with saved draft")
 verify(model.has_valid_draft(),"Continue enabled with valid saved draft")
 verify(not model.set_genre("INVALID"),"invalid genre ignored")
 verify(model.set_genre("Post-punk") and model.game.genre=="Post-punk","genre selected")
 verify(model.to_recruit() and model.screen=="recruit","genre leads into recruit")
 verify(not model.confirm_lineup().get("ok",true),"cannot skip roster/lead")
 verify(not model.choose_vocal("cast_jack").get("ok",true),"cannot assign unselected vocalist")
 verify(model.recruit("cast_jack").get("ok",false),"guitar recruited")
 verify(model.recruit("cast_zoe").get("ok",false),"bass recruited")
 verify(model.recruit("cast_casey").get("ok",false),"drums recruited")
 verify(not model.ready() and model.missing().contains("lead vocals"),"three instrumentalists require explicit vocalist")
 var before_voice: int = int(model.game.spent())
 verify(model.choose_vocal("cast_jack").get("ok",false),"instrumentalist can be assigned lead")
 verify(model.vocal_extra_cost()==5 and model.remaining()==200-before_voice-5,"doubling singing +5 points disclosed")
 verify(model.ready() and model.missing().is_empty(),"guitar bass drums plus explicit singer ready")
 verify(not model.recruit("cast_jack").get("ok",true),"duplicate blocked in opening")
 var draft: Dictionary = model.snapshot()
 verify(model.save_draft(),"draft save succeeds")
 var resumed = Opening.new()
 verify(resumed.load_draft() and resumed.screen=="recruit","Continue loads recruit stage")
 verify(resumed.snapshot()==draft,"resume preserves roster/genre/vocal/points")
 verify(not resumed.restore({"schema_version":1,"screen":"recruit","game":{"phase":"evil"}}),"corrupt setup rejected")
 verify(resumed.snapshot()==draft,"failed restore does not mutate playable draft")
 verify(resumed.remove_member("cast_jack").get("ok",false),"remove guitarist refunds")
 verify(resumed.lead_vocal_id.is_empty() and not resumed.ready(),"removing singer clears assignment")
 verify(resumed.recruit("cast_jack").get("ok",false),"recruit after refund works")
 verify(resumed.choose_vocal("cast_jack").get("ok",false),"reassign vocals after rehire")
 verify(resumed.confirm_lineup().get("ok",false) and resumed.screen=="formed","milestone1 only after viable lineup")
 verify(resumed.formed_once,"milestone once-only flag")
 verify(not resumed.confirm_lineup().get("ok",true),"second milestone attempt blocked")
 var formed = Opening.new()
 verify(formed.load_draft() and formed.screen=="formed" and formed.formed_once,"milestone1 survives restart")
 verify(formed.remaining()>=0,"formed lineup remains in budget")
 var four = Opening.new()
 four.begin_new()
 four.to_recruit()
 for id in ["cast_jack","cast_zoe","cast_casey","cast_maya"]:
  verify(four.recruit(id).get("ok",false),"four-piece hire "+id)
 verify(four.choose_vocal("cast_maya").get("ok",false),"dedicated singer accepted")
 verify(four.vocal_extra_cost()==0 and four.ready(),"dedicated singer zero double fee")
 verify(four.remaining()==200-four.game.spent(),"four-piece budget exact")
 var invalid = Opening.new()
 verify(not invalid.load_draft() or invalid.has_valid_draft(),"valid source path only")

 # Full end-to-end state: naming, deterministic sentiment, one rethink, milestone 2,
 # cosmetic identity, once-only morale, saved Continue and first-practice handoff.
 var complete = Opening.new()
 verify(complete.begin_new(), "end-to-end New Band saves a fresh draft")
 verify(complete.set_genre("Post-punk") and complete.to_recruit(), "end-to-end genre to recruitment")
 for person_id in ["cast_jack","cast_zoe","cast_casey"]:
  verify(bool(complete.recruit(person_id).get("ok",false)), "end-to-end recruit "+person_id)
 verify(complete.choose_vocal("cast_jack").get("ok",false) and complete.ready(), "end-to-end lead singer doubles as guitar")
 verify(complete.confirm_lineup().get("ok",false) and complete.formed_once, "end-to-end milestone 1")
 verify(complete.start_naming() and complete.screen=="name", "end-to-end naming screen")
 var suggestions: Array = complete.suggested_names()
 verify(suggestions.size()==3, "three authored genre suggestions")
 verify(not complete.submit_name(" ","Raw").get("ok",true), "blank name rejected without using rethink")
 verify(not complete.submit_name("X".repeat(37),"Raw").get("ok",true), "overlong name rejected")
 verify(complete.name_revisions==0, "invalid input has no rethink cost")
 verify(complete.submit_name("Concrete Flowers","Dark").get("ok",false), "initial suggestion offers band reactions")
 verify(complete.name_reactions().size()==3, "every chosen bandmate reacts")
 var opinion_before: Array = complete.name_reactions().duplicate(true)
 var counter_before: int = complete.change_counter
 verify(complete.submit_name("concrete flowers","Dark").get("ok",false), "same name and intent is stable")
 verify(complete.name_reactions()==opinion_before and complete.change_counter==counter_before, "repeat preview cannot reroll reactions")
 verify(not complete.submit_name("Different Name","Raw").get("ok",true), "changed proposal requires rethink")
 verify(complete.rethink_name().get("ok",false) and complete.name_revisions==1 and complete.name_offer.is_empty(), "one free rethink is consumed")
 verify(not complete.lock_name().get("ok",true), "cannot lock blank name after rethink")
 verify(complete.submit_name("Étoile Noire","Playful").get("ok",false), "Unicode custom name and chosen intent accepted")
 verify(not complete.rethink_name().get("ok",true), "second free rethink refused")
 var reaction_snapshot: Array = complete.name_reactions().duplicate(true)
 var lock_result: Dictionary = complete.lock_name()
 verify(lock_result.get("ok",false) and complete.screen=="name_milestone", "second milestone triggered only by locked name")
 verify(complete.name_locked=="Étoile Noire" and complete.name_delta==-2, "unpopular final name has disclosed minus-two morale")
 verify(reaction_snapshot.size()==3, "saved free-text opinions exist for all three")
 verify(not complete.lock_name().get("ok",true), "name bonus/penalty cannot settle twice")
 var named = Opening.new()
 verify(named.load_draft() and named.screen=="name_milestone", "Continue resumes name milestone")
 verify(named.snapshot()==complete.snapshot(), "name, intent, rethink and feelings survive strict reload")
 verify(named.start_identity() and named.screen=="identity", "name milestone leads to logo/vibe")
 verify(named.set_identity("Stamp","White / Ink","Atmospheric"), "logo, palette and vibe are selectable and saved")
 verify(named.finish_identity().get("ok",false) and named.identity_complete, "final identity launches canonical gameplay state")
 verify(str(named.game.career.get("band_name",""))=="Étoile Noire" and str(named.game.career.get("logo",""))=="Stamp", "career carries custom band name and logo")
 verify(int(named.game.career.get("morale",0))==53, "unpopular name applies once to 55 baseline morale")
 var finished: Dictionary = named.snapshot()
 verify(not named.finish_identity().get("ok",true) and named.snapshot()==finished, "finished identity and morale are idempotent")
 var full_reload = Opening.new()
 verify(full_reload.load_draft() and full_reload.snapshot()==finished, "Continue restores complete identity without loss")
 verify(full_reload.start_playing() and full_reload.screen=="play" and full_reload.game.phase=="play", "completed band enters live rehearsal gameplay")
 verify(not full_reload.start_playing(), "repeated gameplay handoff cannot re-launch")
 var play_snapshot: Dictionary = full_reload.snapshot()
 var again = Opening.new()
 verify(again.load_draft() and again.snapshot()==play_snapshot, "Continue resumes gameplay without duplicated name consequence")
 verify(int(again.game.career.get("morale",0))==53, "reloaded gameplay retains one name penalty")
 verify(not again.restore({"schema_version":1,"screen":"play","game":{"phase":"evil"}}), "corrupt gameplay restore refused")
 verify(again.snapshot()==play_snapshot, "corrupt restore cannot mutate running band")
 var adored = Opening.new()
 adored.begin_new()
 adored.to_recruit()
 for id in ["cast_jack","cast_ben","cast_marcus"]:
  verify(adored.recruit(id).get("ok",false), "unanimous-love roster member "+id)
 verify(adored.choose_vocal("cast_jack").get("ok",false) and adored.confirm_lineup().get("ok",false), "unanimous-love trio valid")
 verify(adored.start_naming() and adored.submit_name("Side Street","Raw").get("ok",false), "unanimous-love name offered")
 var everyone_loves := true
 for opinion in adored.name_reactions():
  if str(opinion.get("reaction",""))!="love":
   everyone_loves=false
 verify(everyone_loves and adored.name_reactions().size()==3, "authored Raw fans all love the band name")
 verify(adored.lock_name().get("ok",false) and adored.name_delta==3, "unanimous-love bonus settles once")
 verify(adored.start_identity() and adored.finish_identity().get("ok",false), "unanimous-love identity finishes")
 verify(int(adored.game.career.get("morale",0))==58, "unanimous-love bonus raises career morale once")
 var loved_complete: Dictionary = adored.snapshot()
 verify(not adored.finish_identity().get("ok",true) and adored.snapshot()==loved_complete, "unanimous love cannot be farmed by repeat finish")
 print("C27_OPENING_RESULT ",JSON.stringify({"checks":checks,"failures":failures,"coverage":"full_model_opening_naming_identity_save_play","save_path":Opening.SAVE_PATH}))
 quit(0 if failures.is_empty() else 1)
