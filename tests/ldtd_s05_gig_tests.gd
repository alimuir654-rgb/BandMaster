extends SceneTree
## S05 authoritative show-day model, cue state, HOLD and once-only settlement.
const Model = preload("res://Scripts/ldtd_gig_night_preview.gd")
const Calendar = preload("res://Scripts/gig_calendar.gd")
var failures: int = 0
func _initialize() -> void:
	call_deferred("_run")
func _check(ok: bool,detail: String) -> void:
	if not ok:
		failures += 1
		push_error("S05 FAILURE: "+detail)
func _run() -> void:
	var original: Dictionary = Model.sample_state()
	_check(not original.is_empty(),"sample booked through authoritative Calendar.book")
	_check(int(original.get("tour_day",0))==int(original.get("booked_show",{}).get("day",-1)),"sample on actual booked day")
	_check(not bool(Model.settle(original,0,true,true,false,false).get("ok",false)),"no zero-song payout")
	_check(not bool(Model.settle(original,3,true,true,true,false).get("ok",false)),"HOLD blocks payout")
	_check(not bool(Model.settle(original,3,false,true,false,false).get("ok",false)),"unsafe gear blocks payout")
	_check(not bool(Model.choose_approach(original,"unknown").get("ok",false)),"invalid approach blocked")
	var chosen: Dictionary = Model.choose_approach(original,"crowd")
	_check(bool(chosen.get("ok",false)),"real approach chosen")
	var state: Dictionary = chosen.get("state",{})
	_check(str(state.get("booked_show",{}).get("approach",""))=="crowd","approach persists in local booking")
	_check(str(original.get("booked_show",{}).get("approach",""))=="tight","source not mutated")
	var early: Dictionary = state.duplicate(true)
	early["tour_day"] = int(early["tour_day"])-1
	_check(not bool(Model.settle(early,3,true,true,false,false).get("ok",false)),"early show blocked")
	var packed: PackedScene = load("res://poc/ldtd_gig_night.tscn")
	_check(packed!=null,"scene imports")
	if packed==null:
		quit(1)
		return
	var view: Control = packed.instantiate()
	get_root().add_child(view)
	for i in range(7):
		await process_frame
	_check(view.journey_step==0 and view.phase=="day","real DAY load-in")
	_check(not view.can_go(),"no stage GO before safety")
	view.advance_journey()
	_check(view.journey_step==0,"no phase skipping")
	view.toggle_equipment()
	view.advance_journey()
	_check(view.journey_step==1 and view.phase=="dusk","DUSK soundcheck follows load-in")
	view.advance_journey()
	_check(view.journey_step==1,"soundcheck required")
	view.toggle_soundcheck()
	view.choose_approach("wild")
	view.advance_journey()
	_check(view.journey_step==2 and view.phase=="night","NIGHT stage follows soundcheck")
	_check(str(view.demo_state.get("booked_show",{}).get("approach",""))=="wild","approach saved in booking")
	view.toggle_hold()
	view.fire_go()
	_check(view.songs_played==0,"HOLD blocks GO")
	view.toggle_hold()
	view.select_song(2)
	view.fire_go()
	_check(view.songs_played==0,"cannot play out-of-order cue")
	view.select_song(0)
	view.fire_go()
	_check(view.songs_played==1,"first cue played")
	view.choose_approach("crowd")
	_check(str(view.demo_state.get("booked_show",{}).get("approach",""))=="wild","approach locked after first cue")
	view.fire_go()
	view.fire_go()
	_check(view.songs_played==3,"three ordered cues played")
	view.fire_encore()
	_check(view.encore_fired,"optional encore cue does not pay extra")
	var pre: String = JSON.stringify(view.demo_state)
	view.advance_journey()
	_check(view.journey_step==3 and view.settled and view.settlement_count==1,"one real settlement")
	_check(view.demo_state.get("gig_history",[]).size()==1 and Calendar.pending(view.demo_state).is_empty(),"real show recorded and booking cleared")
	_check(JSON.stringify(view.demo_state)!=pre,"local state changed on actual show")
	var finished: String = JSON.stringify(view.demo_state)
	view.advance_journey()
	view.fire_go()
	_check(view.settlement_count==1 and JSON.stringify(view.demo_state)==finished,"cannot settle twice")
	_check(JSON.parse_string(finished) is Dictionary,"result JSON-compatible")
	_check(original.get("gig_history",[]).is_empty(),"sample source unchanged")
	var source: String = FileAccess.get_file_as_string("res://poc/ldtd_gig_night.gd")
	_check(not source.contains("FileAccess.open(") and not source.contains("user://") and not source.contains("SaveService"),"no production persistence")
	view.queue_free()
	if failures>0:
		push_error("S05 FAILED: %d checks" % failures)
		quit(1)
	else:
		print("LDTD S05 GIG DAY DUSK NIGHT, THREE CUES AND ONCE-ONLY CALENDAR SETTLEMENT PASSED")
		quit(0)
